# ─── Admin Access ────────────────────────────────────────────────────────────
# Set a strong password. This is the only credential needed to log in.
ADMIN_PASSWORD=change_me_please

# Random secret used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_32_char_random_string

# ─── Gmail OAuth2 ─────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create a project, enable Gmail API
# 3. Create OAuth2 credentials (Web Application type)
# 4. Add redirect URI: https://support.rajuan.app/api/auth/gmail/callback
# 5. Paste Client ID and Client Secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://support.rajuan.app/api/auth/gmail/callback

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://support.rajuan.app
NODE_ENV=production

# OpenAI key and model are stored in the database via the Settings UI —
# you do NOT need to set them here.
