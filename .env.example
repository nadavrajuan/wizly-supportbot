# ─── Admin Access ────────────────────────────────────────────────────────────
# Set a strong password. This is the only credential needed to log in.
ADMIN_PASSWORD=change_me_please

# Random secret used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_32_char_random_string

# ─── Gmail OAuth2 ─────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create a project, enable Gmail API
# 3. Create OAuth2 credentials (Web Application type)
# 4. Add redirect URI: https://wyzly-support.tacobrain.online/api/auth/gmail/callback
# 5. Paste Client ID and Client Secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://wyzly-support.tacobrain.online/api/auth/gmail/callback

# ─── App ─────────────────────────────────────────────────────────────────────
# Public URL (required behind Kubernetes ingress for OAuth redirects)
APP_URL=https://wyzly-support.tacobrain.online
# Directory for the SQLite database (default: ./data relative to cwd)
DATA_DIR=./data
NODE_ENV=production

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Set AI_PROVIDER=azure to use Azure OpenAI (env vars below).
# Leave unset to use the OpenAI key stored in the database via the Settings UI.
AI_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://wizly-support-openai.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-chat
